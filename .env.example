# Database / infra / services
DATABASE_URL=postgresql+psycopg://placepilot:placepilot@localhost:5432/placepilot
REDIS_URL=redis://localhost:6379/0

# Weaviate (local Docker instance, dev through production)
WEAVIATE_URL=http://localhost:8080

# Groq (LLM inference)
GROQ_API_KEY=your-groq-api-key
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Embeddings (local sentence-transformers model, no API needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GROQ_API_KEY = 
GROQ_MODEL= 