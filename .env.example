# Database / infra / services
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/placepilot
REDIS_URL=redis://localhost:6379/0

# Weaviate (local Docker instance, dev through production)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051

# Groq (LLM inference)
GROQ_API_KEY=your-groq-api-key
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

# Auth — MUST be a long random string in production; startup fails on the default
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Embeddings (local sentence-transformers model, no API needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MCP servers (bind host + ports) and the agent-side URLs (defaults derive from host/ports;
# set the URLs explicitly when servers run on another host, e.g. in Docker)
MCP_HOST=127.0.0.1
MCP_PLACEMENT_PORT=8101
MCP_STUDENT_PORT=8102
MCP_KNOWLEDGE_PORT=8103
#MCP_PLACEMENT_URL=http://127.0.0.1:8101/mcp
#MCP_STUDENT_URL=http://127.0.0.1:8102/mcp
#MCP_KNOWLEDGE_URL=http://127.0.0.1:8103/mcp

# Agent -> MCP call policy
MCP_TOOL_TIMEOUT_S=20
MCP_TOOL_RETRIES=1
MCP_CATALOG_TTL_S=300

# RAG / retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
HYBRID_ALPHA=0.65
RETRIEVAL_MIN_SCORE_HYBRID=0.70
RETRIEVAL_MIN_SCORE_VECTOR=0.30

# Document upload limits (knowledge corpus)
MAX_UPLOAD_BYTES=10485760
ALLOWED_DOC_TYPES=.pdf,.txt,.md

# Rate limiting (per user)
AI_CHAT_RATE_LIMIT=20
AI_CHAT_RATE_WINDOW_S=60

# Observability
LOG_LEVEL=INFO
